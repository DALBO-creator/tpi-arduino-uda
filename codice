#include "DHT.h"

#define DHTPIN 2     // Pin a cui è collegato il sensore
#define DHTTYPE DHT11

const int ledVerde = 12;
const int ledRosso = 13;

DHT dht(DHTPIN, DHTTYPE);

void setup() {
  Serial.begin(9600);
  Serial.println("Avvio sensore DHT11...");
  
  dht.begin();
  pinMode(ledVerde, OUTPUT);
  pinMode(ledRosso, OUTPUT);
}

void loop() {
  // Aspetta un paio di secondi tra una lettura e l'altra
  delay(2000);

  // Leggi la temperatura come Celsius
  float t = dht.readTemperature();

  // Controllo se la lettura è andata a buon fine
  if (isnan(t)) {
    Serial.println("Errore di lettura dal sensore DHT!");
    return;
  }

  Serial.print("Temperatura: ");
  Serial.print(t);
  Serial.println(" C");

  // Logica LED
  if (t > 25.0) {
    digitalWrite(ledRosso, HIGH);
    digitalWrite(ledVerde, LOW);
  } else {
    digitalWrite(ledRosso, LOW);
    digitalWrite(ledVerde, HIGH);
  }
}